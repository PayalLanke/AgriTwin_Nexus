# AgriTwin Nexus Environment Configuration

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./agritwin.db

# JWT Secret Key
SECRET_KEY=agritwin_super_secret_jwt_key_2026

# Google Earth Engine (GEE) Satellite Configuration
GEE_PROJECT_ID=agritwin-nexus-gee-project
GEE_SERVICE_ACCOUNT=gee-service@agritwin-nexus.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Live Meteorological Weather API (Optional OpenWeatherMap key; Open-Meteo fallback is built-in)
WEATHER_API_KEY=your_openweathermap_api_key_here
